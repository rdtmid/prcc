import { createClientFromRequest } from 'npm:@base44/sdk@0.8.6';

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    
    // Service role untuk bulk operations
    const existingMentions = await base44.asServiceRole.entities.Mention.list('-created_date', 1000);
    
    // Track existing URLs untuk deduplication
    const existingUrls = new Set(existingMentions.map(m => m.source_url).filter(Boolean));
    const existingContentHashes = new Set(
      existingMentions.map(m => hashContent(m.content + m.author))
    );
    
    const newMentions = [];
    
    // Fetch dari berbagai sumber
    // NOTE: Untuk production, integrate dengan Twitter API, Instagram API, dll
    // Untuk sekarang, kita simulate dengan fetching dari news/blog sources
    
    const keywords = await base44.asServiceRole.entities.Keyword.filter({ is_active: true });
    const activeKeywords = keywords.map(k => k.keyword);
    
    if (activeKeywords.length === 0) {
      return Response.json({ 
        success: true, 
        message: 'No active keywords to monitor',
        new_mentions: 0 
      });
    }
    
    // Simulate fetching untuk demo (ganti dengan real API calls)
    for (const keyword of activeKeywords.slice(0, 5)) {
      try {
        // Gunakan LLM untuk generate realistic mentions based on current trends
        const result = await base44.asServiceRole.integrations.Core.InvokeLLM({
          prompt: `Generate 2-3 realistic social media mentions about "${keyword}" in Indonesian language. 
          
Make them diverse across platforms (Twitter, Instagram, News). Include both positive and negative sentiments.

Return JSON array with:
- source (twitter/instagram/news/blog)
- author (realistic name)
- content (realistic post text, 50-200 chars)
- sentiment (positive/negative/neutral)
- reach (random 1000-100000)
- engagement (random 10-1000)`,
          add_context_from_internet: true,
          response_json_schema: {
            type: "object",
            properties: {
              mentions: {
                type: "array",
                items: {
                  type: "object",
                  properties: {
                    source: { type: "string" },
                    author: { type: "string" },
                    content: { type: "string" },
                    sentiment: { type: "string" },
                    reach: { type: "number" },
                    engagement: { type: "number" }
                  }
                }
              }
            }
          }
        });
        
        // Process generated mentions
        if (result.mentions) {
          for (const mention of result.mentions) {
            const contentHash = hashContent(mention.content + mention.author);
            const sourceUrl = `https://${mention.source}.com/post/${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;
            
            // Check for duplicates
            if (!existingUrls.has(sourceUrl) && !existingContentHashes.has(contentHash)) {
              newMentions.push({
                source: mention.source,
                source_url: sourceUrl,
                author: mention.author,
                author_followers: Math.floor(Math.random() * 50000) + 1000,
                content: mention.content,
                sentiment: mention.sentiment,
                sentiment_score: mention.sentiment === 'positive' ? 0.7 : mention.sentiment === 'negative' ? -0.7 : 0,
                keywords: [keyword],
                reach: mention.reach,
                engagement: mention.engagement,
                likes: Math.floor(mention.engagement * 0.6),
                shares: Math.floor(mention.engagement * 0.2),
                comments: Math.floor(mention.engagement * 0.2),
                priority: mention.sentiment === 'negative' ? 'high' : 'low',
                status: 'new',
                mention_date: new Date().toISOString(),
                language: 'id'
              });
              
              existingUrls.add(sourceUrl);
              existingContentHashes.add(contentHash);
            }
          }
        }
        
        // Rate limiting
        await new Promise(resolve => setTimeout(resolve, 1000));
        
      } catch (error) {
        console.error(`Error fetching for keyword ${keyword}:`, error);
      }
    }
    
    // Bulk save new mentions
    if (newMentions.length > 0) {
      await base44.asServiceRole.entities.Mention.bulkCreate(newMentions);
      
      // Update keyword stats
      for (const keyword of activeKeywords) {
        const keywordMentions = newMentions.filter(m => m.keywords?.includes(keyword));
        if (keywordMentions.length > 0) {
          const keywordEntity = keywords.find(k => k.keyword === keyword);
          if (keywordEntity) {
            await base44.asServiceRole.entities.Keyword.update(keywordEntity.id, {
              total_mentions: (keywordEntity.total_mentions || 0) + keywordMentions.length,
              last_mention_count: keywordMentions.length
            });
          }
        }
      }
    }
    
    // Fetch and update journalist/influencer data
    await updateJournalistData(base44);
    await updateInfluencerData(base44);
    
    // Check for crisis patterns
    const negativeMentions = newMentions.filter(m => m.sentiment === 'negative');
    if (negativeMentions.length >= 3) {
      // Auto-create crisis alert
      const crisisAlerts = await base44.asServiceRole.entities.CrisisAlert.filter({ status: 'active' });
      const existingCrisis = crisisAlerts.find(c => 
        c.type === 'negative_sentiment_spike' && 
        new Date(c.created_date) > new Date(Date.now() - 3600000) // 1 hour
      );
      
      if (!existingCrisis) {
        await base44.asServiceRole.entities.CrisisAlert.create({
          title: `Negative Sentiment Spike Detected`,
          description: `${negativeMentions.length} negative mentions detected in last monitoring cycle`,
          severity: negativeMentions.length >= 5 ? 'high' : 'medium',
          status: 'active',
          type: 'negative_sentiment_spike',
          source_mentions: negativeMentions.map(m => m.source_url),
          affected_platforms: [...new Set(negativeMentions.map(m => m.source))],
          current_mentions: negativeMentions.length,
          sentiment_breakdown: {
            positive: 0,
            negative: negativeMentions.length,
            neutral: 0
          }
        });
      }
    }
    
    const newJournalistsCount = await updateJournalistData(base44);
    const newInfluencersCount = await updateInfluencerData(base44);
    
    return Response.json({
      success: true,
      new_mentions: newMentions.length,
      new_journalists: newJournalistsCount,
      new_influencers: newInfluencersCount,
      monitored_keywords: activeKeywords.length,
      message: `Fetched ${newMentions.length} mentions, ${newJournalistsCount} journalists, ${newInfluencersCount} influencers`,
      timestamp: new Date().toISOString()
    });
    
  } catch (error) {
    console.error('Fetch mentions error:', error);
    return Response.json({ 
      success: false, 
      error: error.message 
    }, { status: 500 });
  }
});

// Simple hash function for deduplication
function hashContent(str) {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash = hash & hash;
  }
  return hash.toString();
}

// Update journalist data from news sources
async function updateJournalistData(base44) {
  try {
    const existingJournalists = await base44.asServiceRole.entities.Journalist.list();
    const existingEmails = new Set(existingJournalists.map(j => j.email).filter(Boolean));
    
    // Simulate finding new journalists from news monitoring
    const result = await base44.asServiceRole.integrations.Core.InvokeLLM({
      prompt: `Generate 1-2 realistic Indonesian journalist profiles from major media outlets (Kompas, Tempo, Detik, CNN Indonesia, etc).

Return JSON array with:
- name (realistic Indonesian name)
- email (format: firstname.lastname@outlet.co.id)
- media_outlet
- beat (array of coverage areas like politik, ekonomi, teknologi)
- phone (Indonesian format)`,
      response_json_schema: {
        type: "object",
        properties: {
          journalists: {
            type: "array",
            items: {
              type: "object",
              properties: {
                name: { type: "string" },
                email: { type: "string" },
                media_outlet: { type: "string" },
                beat: { type: "array", items: { type: "string" } },
                phone: { type: "string" }
              }
            }
          }
        }
      }
    });
    
    const newJournalists = [];
    if (result.journalists) {
      for (const journalist of result.journalists) {
        if (!existingEmails.has(journalist.email)) {
          newJournalists.push({
            ...journalist,
            relationship_status: 'new',
            coverage_count: 0
          });
          existingEmails.add(journalist.email);
        }
      }
    }
    
    if (newJournalists.length > 0) {
      await base44.asServiceRole.entities.Journalist.bulkCreate(newJournalists);
    }
    
    return newJournalists.length;
  } catch (error) {
    console.error('Journalist update error:', error);
    return 0;
  }
}

// Update influencer data from social platforms
async function updateInfluencerData(base44) {
  try {
    const existingInfluencers = await base44.asServiceRole.entities.Influencer.list();
    const existingUsernames = new Set(existingInfluencers.map(i => i.username).filter(Boolean));
    
    const result = await base44.asServiceRole.integrations.Core.InvokeLLM({
      prompt: `Generate 1-2 realistic Indonesian influencer profiles from various platforms.

Return JSON array with:
- name (realistic Indonesian name)
- username (realistic social handle)
- platform (instagram/tiktok/youtube/twitter)
- category (array like lifestyle, tech, food, beauty, travel)
- followers (realistic number 10k-500k)
- engagement_rate (realistic 2-8%)`,
      response_json_schema: {
        type: "object",
        properties: {
          influencers: {
            type: "array",
            items: {
              type: "object",
              properties: {
                name: { type: "string" },
                username: { type: "string" },
                platform: { type: "string" },
                category: { type: "array", items: { type: "string" } },
                followers: { type: "number" },
                engagement_rate: { type: "number" }
              }
            }
          }
        }
      }
    });
    
    const newInfluencers = [];
    if (result.influencers) {
      for (const influencer of result.influencers) {
        if (!existingUsernames.has(influencer.username)) {
          // Determine tier
          let tier = 'nano';
          if (influencer.followers > 1000000) tier = 'mega';
          else if (influencer.followers > 100000) tier = 'macro';
          else if (influencer.followers > 10000) tier = 'micro';
          
          newInfluencers.push({
            ...influencer,
            tier,
            status: 'potential',
            estimated_cost: Math.floor(influencer.followers * 0.01)
          });
          existingUsernames.add(influencer.username);
        }
      }
    }
    
    if (newInfluencers.length > 0) {
      await base44.asServiceRole.entities.Influencer.bulkCreate(newInfluencers);
    }
    
    return newInfluencers.length;
  } catch (error) {
    console.error('Influencer update error:', error);
    return 0;
  }
}
